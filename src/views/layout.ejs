<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — RyuBreed Academia Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen flex flex-col font-sans">
  <nav class="bg-slate-800 border-b border-slate-700 px-6 py-4 flex justify-between items-center">
    <div class="flex items-center space-x-4">
      <div class="w-9 h-9 rounded-xl bg-indigo-600 flex items-center justify-center font-bold text-white shadow-lg shadow-indigo-600/30">
        R
      </div>
      <a href="/" class="text-lg font-bold text-white tracking-tight">RyuBreed Admin Hub</a>
      <div class="hidden md:flex space-x-6 text-sm font-semibold pl-6 border-l border-slate-700">
        <a href="/" class="hover:text-indigo-400 text-slate-300">Dashboard</a>
        <a href="/institutes" class="hover:text-indigo-400 text-slate-300">Institutes</a>
        <a href="/subscriptions" class="hover:text-indigo-400 text-slate-300">Subscriptions</a>
        <a href="/audit" class="hover:text-indigo-400 text-slate-300">Audit Logs</a>
      </div>
    </div>
    <div class="flex items-center space-x-4">
      <span class="text-xs text-slate-400 hidden sm:inline"><%= user ? user.email : '' %></span>
      <a href="/auth/logout" class="bg-slate-700 hover:bg-slate-600 text-xs px-3 py-1.5 rounded-lg border border-slate-600">
        Sign Out
      </a>
    </div>
  </nav>

  <main class="flex-1 max-w-7xl w-full mx-auto p-4 sm:p-6 lg:p-8">
    <%- body %>
  </main>

  <footer class="border-t border-slate-800 p-4 text-center text-xs text-slate-500">
    RyuBreed Academia &copy; <%= new Date().getFullYear() %> • Node.js Express Admin Service
  </footer>
</body>
</html>

