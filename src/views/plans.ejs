<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — RyuBreed Academia Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; }
    .font-mono { font-family: 'JetBrains Mono', monospace; }
  </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col antialiased selection:bg-indigo-500 selection:text-white">

  <!-- Top Navigation Bar -->
  <header class="bg-slate-900/90 backdrop-blur-md border-b border-slate-800 sticky top-0 z-40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <div class="flex items-center space-x-6">
        <a href="/" class="flex items-center space-x-3 group">
          <div class="w-8 h-8 rounded-lg bg-indigo-600 flex items-center justify-center font-bold text-white text-sm">
            R
          </div>
          <div>
            <span class="text-sm font-semibold text-white tracking-tight block leading-tight">RyuBreed Academia</span>
            <span class="text-[10px] font-medium text-slate-400 block">Admin Hub</span>
          </div>
        </a>

        <nav class="hidden md:flex items-center space-x-1 pl-6 border-l border-slate-800">
          <a href="/" class="px-3 py-1.5 rounded-lg text-xs font-medium text-slate-400 hover:text-white hover:bg-slate-800/60 transition-colors">
            <i class="fa-solid fa-chart-pie mr-1.5 text-slate-500"></i>Dashboard
          </a>
          <a href="/institutes" class="px-3 py-1.5 rounded-lg text-xs font-medium text-slate-400 hover:text-white hover:bg-slate-800/60 transition-colors">
            <i class="fa-solid fa-building-columns mr-1.5 text-slate-500"></i>Institutes
          </a>
          <a href="/subscriptions" class="px-3 py-1.5 rounded-lg text-xs font-medium text-slate-400 hover:text-white hover:bg-slate-800/60 transition-colors">
            <i class="fa-solid fa-credit-card mr-1.5 text-slate-500"></i>Subscriptions
          </a>
          <a href="/plans" class="px-3 py-1.5 rounded-lg text-xs font-medium text-white bg-slate-800 border border-slate-700/60 transition-colors">
            <i class="fa-solid fa-tags mr-1.5 text-indigo-400"></i>Plans
          </a>
          <a href="/audit" class="px-3 py-1.5 rounded-lg text-xs font-medium text-slate-400 hover:text-white hover:bg-slate-800/60 transition-colors">
            <i class="fa-solid fa-shield-halved mr-1.5 text-slate-500"></i>Audit Logs
          </a>
        </nav>
      </div>

      <div class="flex items-center space-x-4">
        <div class="text-right hidden sm:block">
          <div class="text-xs font-medium text-slate-200"><%= user ? (user.name || user.email) : 'Administrator' %></div>
          <div class="text-[10px] font-mono text-indigo-400">ADMIN-OPERATOR</div>
        </div>
        <a href="/auth/logout" class="inline-flex items-center justify-center h-8 px-3 rounded-lg text-xs font-medium text-slate-300 hover:text-white bg-slate-800 hover:bg-slate-700 border border-slate-700 transition-colors">
          <i class="fa-solid fa-right-from-bracket mr-1.5 text-slate-400"></i>Sign Out
        </a>
      </div>
    </div>
  </header>

  <!-- Main Content Container -->
  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">

    <!-- Notifications -->
    <% if (locals.success) { %>
      <div class="p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs flex items-center space-x-3">
        <i class="fa-solid fa-circle-check text-sm"></i>
        <span><%= success %></span>
      </div>
    <% } %>

    <% if (locals.error) { %>
      <div class="p-4 rounded-xl bg-rose-500/10 border border-rose-500/30 text-rose-400 text-xs flex items-center space-x-3">
        <i class="fa-solid fa-triangle-exclamation text-sm"></i>
        <span><%= error %></span>
      </div>
    <% } %>

    <!-- Header & Info Banner -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 border-b border-slate-800/80 pb-6">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-white flex items-center gap-2.5">
          <i class="fa-solid fa-tags text-indigo-400 text-xl"></i>
          Subscription Plans & Pricing Control
        </h1>
        <p class="text-xs text-slate-400 mt-1">
          Configure live pricing for Core and Smart tiers. Changes synchronize instantly to the Cloudflare Worker API, Flutter apps, and Razorpay payment orders.
        </p>
      </div>
      <div class="inline-flex items-center px-3 py-1.5 rounded-lg bg-indigo-500/10 border border-indigo-500/30 text-indigo-300 text-xs font-medium">
        <i class="fa-solid fa-bolt mr-2 text-indigo-400"></i>
        Live Dynamic Price Binding Active
      </div>
    </div>

    <!-- Live Testing Tip Banner -->
    <div class="p-4 rounded-2xl bg-amber-500/10 border border-amber-500/20 text-amber-300 text-xs flex items-start space-x-3">
      <i class="fa-solid fa-lightbulb text-amber-400 mt-0.5 text-sm"></i>
      <div>
        <span class="font-semibold text-amber-200">Payment Testing Tip:</span>
        To test live Razorpay payments with real UPI / cards without paying full amounts, simply set the monthly price below to <strong class="text-white">₹1</strong> (or ₹5), click <strong class="text-white">Save Changes</strong>, and make the payment in the Flutter app. Once verified, return here and set it back to <strong class="text-white">₹99</strong> / <strong class="text-white">₹199</strong>.
      </div>
    </div>

    <% 
      const core = plans.find(p => p.id === 'core99') || { name: 'Core Plan', priceINR: 99, annualPriceINR: 948 };
      const smart = plans.find(p => p.id === 'smart199') || { name: 'Smart Plan', priceINR: 199, annualPriceINR: 1908 };
    %>

    <!-- Plan Editor Form -->
    <form action="/plans/update" method="POST" class="space-y-6">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

        <!-- Core Plan Card -->
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 space-y-5 relative overflow-hidden shadow-xl">
          <div class="flex items-center justify-between">
            <div class="flex items-center space-x-3">
              <div class="w-10 h-10 rounded-xl bg-blue-600/20 border border-blue-500/30 flex items-center justify-center text-blue-400">
                <i class="fa-solid fa-layer-group text-lg"></i>
              </div>
              <div>
                <h2 class="text-base font-semibold text-white">Core Plan</h2>
                <span class="text-[11px] text-slate-400 font-mono">Plan ID: core99</span>
              </div>
            </div>
            <span class="px-2.5 py-1 rounded-full text-[10px] font-semibold bg-blue-500/10 text-blue-400 border border-blue-500/30">
              Essential
            </span>
          </div>

          <div class="space-y-4 pt-2">
            <div>
              <label class="block text-xs font-medium text-slate-300 mb-1.5">Display Name</label>
              <input type="text" name="coreName" value="<%= core.name %>" required
                class="w-full bg-slate-950 border border-slate-700/80 rounded-xl px-3.5 py-2.5 text-xs text-white focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500" />
            </div>

            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="block text-xs font-medium text-slate-300 mb-1.5">Monthly Price (₹)</label>
                <div class="relative">
                  <span class="absolute left-3.5 top-2.5 text-slate-400 text-xs">₹</span>
                  <input type="number" name="corePrice" value="<%= core.priceINR %>" min="1" required
                    class="w-full bg-slate-950 border border-slate-700/80 rounded-xl pl-8 pr-3.5 py-2.5 text-xs text-white font-semibold focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500" />
                </div>
              </div>

              <div>
                <label class="block text-xs font-medium text-slate-300 mb-1.5">Annual Price (₹)</label>
                <div class="relative">
                  <span class="absolute left-3.5 top-2.5 text-slate-400 text-xs">₹</span>
                  <input type="number" name="coreAnnualPrice" value="<%= core.annualPriceINR || (core.priceINR * 12) %>" min="1" required
                    class="w-full bg-slate-950 border border-slate-700/80 rounded-xl pl-8 pr-3.5 py-2.5 text-xs text-white font-semibold focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500" />
                </div>
              </div>
            </div>

            <div class="pt-2">
              <label class="block text-[11px] font-medium text-slate-400 mb-1.5">Included Entitlements:</label>
              <ul class="text-xs text-slate-400 space-y-1 pl-4 list-disc">
                <li>Up to 150 Students</li>
                <li>Up to 10 Batches & 5 Staff</li>
                <li>Attendance & Fee Tracking</li>
                <li>Cloud Sync & PDF Invoices</li>
              </ul>
            </div>
          </div>
        </div>

        <!-- Smart Plan Card -->
        <div class="bg-slate-900 border border-indigo-500/30 rounded-2xl p-6 space-y-5 relative overflow-hidden shadow-xl">
          <div class="flex items-center justify-between">
            <div class="flex items-center space-x-3">
              <div class="w-10 h-10 rounded-xl bg-indigo-600/20 border border-indigo-500/30 flex items-center justify-center text-indigo-400">
                <i class="fa-solid fa-crown text-lg"></i>
              </div>
              <div>
                <h2 class="text-base font-semibold text-white">Smart Plan</h2>
                <span class="text-[11px] text-slate-400 font-mono">Plan ID: smart199</span>
              </div>
            </div>
            <span class="px-2.5 py-1 rounded-full text-[10px] font-semibold bg-indigo-500/10 text-indigo-400 border border-indigo-500/30">
              Most Popular
            </span>
          </div>

          <div class="space-y-4 pt-2">
            <div>
              <label class="block text-xs font-medium text-slate-300 mb-1.5">Display Name</label>
              <input type="text" name="smartName" value="<%= smart.name %>" required
                class="w-full bg-slate-950 border border-slate-700/80 rounded-xl px-3.5 py-2.5 text-xs text-white focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500" />
            </div>

            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="block text-xs font-medium text-slate-300 mb-1.5">Monthly Price (₹)</label>
                <div class="relative">
                  <span class="absolute left-3.5 top-2.5 text-slate-400 text-xs">₹</span>
                  <input type="number" name="smartPrice" value="<%= smart.priceINR %>" min="1" required
                    class="w-full bg-slate-950 border border-slate-700/80 rounded-xl pl-8 pr-3.5 py-2.5 text-xs text-white font-semibold focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500" />
                </div>
              </div>

              <div>
                <label class="block text-xs font-medium text-slate-300 mb-1.5">Annual Price (₹)</label>
                <div class="relative">
                  <span class="absolute left-3.5 top-2.5 text-slate-400 text-xs">₹</span>
                  <input type="number" name="smartAnnualPrice" value="<%= smart.annualPriceINR || (smart.priceINR * 12) %>" min="1" required
                    class="w-full bg-slate-950 border border-slate-700/80 rounded-xl pl-8 pr-3.5 py-2.5 text-xs text-white font-semibold focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500" />
                </div>
              </div>
            </div>

            <div class="pt-2">
              <label class="block text-[11px] font-medium text-slate-400 mb-1.5">Included Entitlements:</label>
              <ul class="text-xs text-slate-400 space-y-1 pl-4 list-disc">
                <li>Unlimited Students, Batches & Staff</li>
                <li>Full Academics Hub (Homework & Tests)</li>
                <li>Study Materials & Lesson Plans</li>
                <li>Automated WhatsApp Reports & Queue</li>
                <li>ID Cards & Merit Certificates</li>
              </ul>
            </div>
          </div>
        </div>

      </div>

      <!-- Action Buttons -->
      <div class="flex items-center justify-end space-x-3 pt-4 border-t border-slate-800">
        <a href="/plans" class="px-5 py-2.5 rounded-xl border border-slate-700 text-xs font-medium text-slate-300 hover:bg-slate-800 transition-colors">
          Reset to Saved
        </a>
        <button type="submit" class="px-6 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-xs font-semibold text-white shadow-lg shadow-indigo-600/30 transition-all flex items-center space-x-2">
          <i class="fa-solid fa-floppy-disk"></i>
          <span>Save Changes & Sync Across Apps</span>
        </button>
      </div>

    </form>

  </main>

  <footer class="border-t border-slate-800/80 py-6 mt-12 bg-slate-950 text-center text-xs text-slate-500">
    RyuBreed Academia &copy; <%= new Date().getFullYear() %> • Authoritative Subscription Administration Engine
  </footer>

</body>
</html>

