<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — RyuBreed Academia Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; }
    .font-mono { font-family: 'JetBrains Mono', monospace; }
  </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col antialiased selection:bg-indigo-500 selection:text-white">

  <!-- Top Navigation Bar -->
  <header class="bg-slate-900/90 backdrop-blur-md border-b border-slate-800 sticky top-0 z-40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <div class="flex items-center space-x-6">
        <a href="/" class="flex items-center space-x-3 group">
          <div class="w-8 h-8 rounded-lg bg-indigo-600 flex items-center justify-center font-bold text-white text-sm">
            R
          </div>
          <div>
            <span class="text-sm font-semibold text-white tracking-tight block leading-tight">RyuBreed Academia</span>
            <span class="text-[10px] font-medium text-slate-400 block">Admin Hub</span>
          </div>
        </a>

        <nav class="hidden md:flex items-center space-x-1 pl-6 border-l border-slate-800">
          <a href="/" class="px-3 py-1.5 rounded-lg text-xs font-medium text-white bg-slate-800 border border-slate-700/60 transition-colors">
            <i class="fa-solid fa-chart-pie mr-1.5 text-indigo-400"></i>Dashboard
          </a>
          <a href="/institutes" class="px-3 py-1.5 rounded-lg text-xs font-medium text-slate-400 hover:text-white hover:bg-slate-800/60 transition-colors">
            <i class="fa-solid fa-building-columns mr-1.5 text-slate-500"></i>Institutes
          </a>
          <a href="/subscriptions" class="px-3 py-1.5 rounded-lg text-xs font-medium text-slate-400 hover:text-white hover:bg-slate-800/60 transition-colors">
            <i class="fa-solid fa-credit-card mr-1.5 text-slate-500"></i>Subscriptions
          </a>
          <a href="/audit" class="px-3 py-1.5 rounded-lg text-xs font-medium text-slate-400 hover:text-white hover:bg-slate-800/60 transition-colors">
            <i class="fa-solid fa-shield-halved mr-1.5 text-slate-500"></i>Audit Logs
          </a>
        </nav>
      </div>

      <div class="flex items-center space-x-3">
        <div class="hidden sm:flex items-center space-x-2 bg-slate-900 border border-slate-800 px-3 py-1 rounded-lg text-xs text-slate-300">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          <span class="font-mono text-[11px] text-slate-300"><%= user ? user.email : 'admin' %></span>
        </div>
        <a href="/auth/logout" class="bg-slate-800 hover:bg-rose-950/50 hover:text-rose-300 hover:border-rose-800/60 text-slate-300 text-xs font-medium px-3.5 py-1.5 rounded-lg border border-slate-700/70 transition-all flex items-center gap-1.5">
          <i class="fa-solid fa-arrow-right-from-bracket text-[11px]"></i>
          <span>Sign Out</span>
        </a>
      </div>
    </div>
  </header>

  <!-- Main Content Container -->
  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">

    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-800">
      <div>
        <h1 class="text-2xl font-bold text-white tracking-tight">System Overview</h1>
        <p class="text-xs text-slate-400 mt-1">Institutional telemetry, cloud entitlements, and revenue metrics</p>
      </div>
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs font-medium bg-slate-900 border border-slate-800 text-slate-300">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          <span>System Healthy</span>
        </span>
      </div>
    </div>

    <!-- Executive Stat Cards (Quiet Graphite Ramp, Tabular Numerals) -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
      <div class="bg-slate-900/60 border border-slate-800 rounded-xl p-4">
        <p class="text-xs text-slate-400 font-medium">Total Institutes</p>
        <p class="text-2xl font-bold text-white font-mono tabular-nums mt-1"><%= totalInstitutes %></p>
        <p class="text-[11px] text-slate-500 mt-1">Tenants in directory</p>
      </div>

      <div class="bg-slate-900/60 border border-slate-800 rounded-xl p-4">
        <p class="text-xs text-slate-400 font-medium">Registered Accounts</p>
        <p class="text-2xl font-bold text-white font-mono tabular-nums mt-1"><%= totalUsers %></p>
        <p class="text-[11px] text-slate-500 mt-1">Auth identity records</p>
      </div>

      <div class="bg-slate-900/60 border border-slate-800 rounded-xl p-4">
        <p class="text-xs text-slate-400 font-medium">Active Subscriptions</p>
        <p class="text-2xl font-bold text-emerald-400 font-mono tabular-nums mt-1"><%= activeSubscriptions %></p>
        <p class="text-[11px] text-slate-500 mt-1">Paid cloud licenses</p>
      </div>

      <div class="bg-slate-900/60 border border-slate-800 rounded-xl p-4">
        <p class="text-xs text-slate-400 font-medium">Active Pilots</p>
        <p class="text-2xl font-bold text-indigo-400 font-mono tabular-nums mt-1"><%= activeTrials %></p>
        <p class="text-[11px] text-slate-500 mt-1">Evaluation periods</p>
      </div>

      <div class="bg-slate-900/60 border border-slate-800 rounded-xl p-4">
        <p class="text-xs text-slate-400 font-medium">Expired Accounts</p>
        <p class="text-2xl font-bold text-amber-400 font-mono tabular-nums mt-1"><%= expiredSubscriptions %></p>
        <p class="text-[11px] text-slate-500 mt-1">Past validity window</p>
      </div>

      <div class="bg-slate-900/60 border border-slate-800 rounded-xl p-4">
        <p class="text-xs text-slate-400 font-medium">Platform Revenue</p>
        <p class="text-2xl font-bold text-white font-mono tabular-nums mt-1">₹<%= totalRevenue.toLocaleString('en-IN') %></p>
        <p class="text-[11px] text-slate-500 mt-1">Settled payments</p>
      </div>
    </div>

    <!-- Architecture & Operational Matrix -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

      <!-- Topology Status -->
      <div class="bg-slate-900/60 border border-slate-800 rounded-2xl p-6 space-y-4">
        <div>
          <h2 class="text-sm font-semibold text-white tracking-tight">System Architecture & Synchronization Topology</h2>
          <p class="text-xs text-slate-400 mt-0.5">Verified service boundaries between mobile, cloud, and local persistence</p>
        </div>

        <div class="space-y-3 pt-2">
          <div class="flex items-center justify-between p-3 rounded-xl bg-slate-950 border border-slate-800 text-xs">
            <div class="flex items-center gap-3">
              <i class="fa-solid fa-server text-indigo-400 text-sm"></i>
              <div>
                <span class="font-medium text-white block">Authoritative Subscription Backend</span>
                <span class="text-[11px] text-slate-400">Cloudflare Worker API with fail-closed security</span>
              </div>
            </div>
            <span class="font-mono text-[11px] text-emerald-400 font-medium">Active</span>
          </div>

          <div class="flex items-center justify-between p-3 rounded-xl bg-slate-950 border border-slate-800 text-xs">
            <div class="flex items-center gap-3">
              <i class="fa-solid fa-database text-sky-400 text-sm"></i>
              <div>
                <span class="font-medium text-white block">Cloud Mirror & License Store</span>
                <span class="text-[11px] text-slate-400">Firestore (Spark Plan, zero Blaze billing dependencies)</span>
              </div>
            </div>
            <span class="font-mono text-[11px] text-emerald-400 font-medium">Connected</span>
          </div>

          <div class="flex items-center justify-between p-3 rounded-xl bg-slate-950 border border-slate-800 text-xs">
            <div class="flex items-center gap-3">
              <i class="fa-solid fa-hard-drive text-amber-400 text-sm"></i>
              <div>
                <span class="font-medium text-white block">Client-Side Persistence</span>
                <span class="text-[11px] text-slate-400">Local SQLite database with offline-first write queue</span>
              </div>
            </div>
            <span class="font-mono text-[11px] text-emerald-400 font-medium">Verified</span>
          </div>

          <div class="flex items-center justify-between p-3 rounded-xl bg-slate-950 border border-slate-800 text-xs">
            <div class="flex items-center gap-3">
              <i class="fa-solid fa-bell text-violet-400 text-sm"></i>
              <div>
                <span class="font-medium text-white block">Broadcast Notification Network</span>
                <span class="text-[11px] text-slate-400">Firebase Cloud Messaging (FCM) batch topics</span>
              </div>
            </div>
            <span class="font-mono text-[11px] text-emerald-400 font-medium">Ready</span>
          </div>
        </div>
      </div>

      <!-- Plan Tier Quotas -->
      <div class="bg-slate-900/60 border border-slate-800 rounded-2xl p-6 space-y-4">
        <div>
          <h2 class="text-sm font-semibold text-white tracking-tight">Active Entitlement Gating</h2>
          <p class="text-xs text-slate-400 mt-0.5">Tier quotas enforced strictly on client and verified server-side</p>
        </div>

        <div class="space-y-3 pt-2">
          <!-- Smart Tier -->
          <div class="p-3.5 rounded-xl bg-slate-950 border border-slate-800 space-y-2">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2">
                <span class="text-xs font-semibold text-indigo-300">Smart Tier</span>
                <span class="font-mono text-[11px] text-slate-400">₹199 / month</span>
              </div>
              <span class="text-[10px] font-semibold text-indigo-400 bg-indigo-950/60 border border-indigo-900/60 px-2 py-0.5 rounded-md">Unlimited</span>
            </div>
            <p class="text-[11px] text-slate-400 leading-relaxed">
              Unlimited students, batches, and staff. Full academic suite: homework, test ranks, study materials, lesson plans, merit certificates, and automated WhatsApp reports.
            </p>
          </div>

          <!-- Core Tier -->
          <div class="p-3.5 rounded-xl bg-slate-950 border border-slate-800 space-y-2">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2">
                <span class="text-xs font-semibold text-sky-300">Core Tier</span>
                <span class="font-mono text-[11px] text-slate-400">₹99 / month</span>
              </div>
              <span class="text-[10px] font-semibold text-sky-400 bg-sky-950/60 border border-sky-900/60 px-2 py-0.5 rounded-md">150 Students</span>
            </div>
            <p class="text-[11px] text-slate-400 leading-relaxed">
              Up to 150 students, 10 batches, and 5 staff members. Essential cloud sync, multi-device access, fee structures, and custom PDF receipts.
            </p>
          </div>

          <!-- Free Local Tier -->
          <div class="p-3.5 rounded-xl bg-slate-950 border border-slate-800 space-y-2">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2">
                <span class="text-xs font-semibold text-slate-300">Local Only</span>
                <span class="font-mono text-[11px] text-slate-500">Free / Offline</span>
              </div>
              <span class="text-[10px] font-semibold text-slate-400 bg-slate-900 border border-slate-800 px-2 py-0.5 rounded-md">25 Students</span>
            </div>
            <p class="text-[11px] text-slate-500 leading-relaxed">
              Up to 25 students, 2 batches, and 1 staff member. Completely offline SQLite local storage with zero cloud synchronization.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Quick Navigation Shortcuts -->
    <div class="border-t border-slate-800 pt-6">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <a href="/institutes" class="p-4 bg-slate-900/60 hover:bg-slate-800/60 border border-slate-800 rounded-xl transition-all group flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-lg bg-indigo-950/70 border border-indigo-900/60 flex items-center justify-center text-indigo-400 text-xs">
              <i class="fa-solid fa-building-columns"></i>
            </div>
            <div>
              <span class="text-xs font-semibold text-white block group-hover:text-indigo-300 transition-colors">Institutes Directory</span>
              <span class="text-[11px] text-slate-400">View <%= totalInstitutes %> tenant profiles</span>
            </div>
          </div>
          <i class="fa-solid fa-arrow-right text-xs text-slate-600 group-hover:text-slate-300 group-hover:translate-x-0.5 transition-all"></i>
        </a>

        <a href="/subscriptions" class="p-4 bg-slate-900/60 hover:bg-slate-800/60 border border-slate-800 rounded-xl transition-all group flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-lg bg-emerald-950/70 border border-emerald-900/60 flex items-center justify-center text-emerald-400 text-xs">
              <i class="fa-solid fa-credit-card"></i>
            </div>
            <div>
              <span class="text-xs font-semibold text-white block group-hover:text-emerald-300 transition-colors">Subscription Ledger</span>
              <span class="text-[11px] text-slate-400">Extend or inspect licenses</span>
            </div>
          </div>
          <i class="fa-solid fa-arrow-right text-xs text-slate-600 group-hover:text-slate-300 group-hover:translate-x-0.5 transition-all"></i>
        </a>

        <a href="/audit" class="p-4 bg-slate-900/60 hover:bg-slate-800/60 border border-slate-800 rounded-xl transition-all group flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-lg bg-amber-950/70 border border-amber-900/60 flex items-center justify-center text-amber-400 text-xs">
              <i class="fa-solid fa-shield-halved"></i>
            </div>
            <div>
              <span class="text-xs font-semibold text-white block group-hover:text-amber-300 transition-colors">Audit & Security</span>
              <span class="text-[11px] text-slate-400">Chronological mutation log</span>
            </div>
          </div>
          <i class="fa-solid fa-arrow-right text-xs text-slate-600 group-hover:text-slate-300 group-hover:translate-x-0.5 transition-all"></i>
        </a>
      </div>
    </div>

  </main>
</body>
</html>
