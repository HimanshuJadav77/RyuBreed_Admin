<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — RyuBreed Academia Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; }
    .font-mono { font-family: 'JetBrains Mono', monospace; }
  </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col antialiased selection:bg-indigo-500 selection:text-white">

  <!-- Top Navigation Bar -->
  <header class="bg-slate-900/90 backdrop-blur-md border-b border-slate-800 sticky top-0 z-40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <div class="flex items-center space-x-6">
        <a href="/" class="flex items-center space-x-3 group">
          <div class="w-8 h-8 rounded-lg bg-indigo-600 flex items-center justify-center font-bold text-white text-sm">
            R
          </div>
          <div>
            <span class="text-sm font-semibold text-white tracking-tight block leading-tight">RyuBreed Academia</span>
            <span class="text-[10px] font-medium text-slate-400 block">Admin Hub</span>
          </div>
        </a>

        <nav class="hidden md:flex items-center space-x-1 pl-6 border-l border-slate-800">
          <a href="/" class="px-3 py-1.5 rounded-lg text-xs font-medium text-slate-400 hover:text-white hover:bg-slate-800/60 transition-colors">
            <i class="fa-solid fa-chart-pie mr-1.5 text-slate-500"></i>Dashboard
          </a>
          <a href="/institutes" class="px-3 py-1.5 rounded-lg text-xs font-medium text-slate-400 hover:text-white hover:bg-slate-800/60 transition-colors">
            <i class="fa-solid fa-building-columns mr-1.5 text-slate-500"></i>Institutes
          </a>
          <a href="/subscriptions" class="px-3 py-1.5 rounded-lg text-xs font-medium text-slate-400 hover:text-white hover:bg-slate-800/60 transition-colors">
            <i class="fa-solid fa-credit-card mr-1.5 text-slate-500"></i>Subscriptions
          </a>
          <a href="/audit" class="px-3 py-1.5 rounded-lg text-xs font-medium text-white bg-slate-800 border border-slate-700/60 transition-colors">
            <i class="fa-solid fa-shield-halved mr-1.5 text-indigo-400"></i>Audit Logs
          </a>
        </nav>
      </div>

      <div class="flex items-center space-x-3">
        <div class="hidden sm:flex items-center space-x-2 bg-slate-900 border border-slate-800 px-3 py-1 rounded-lg text-xs text-slate-300">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          <span class="font-mono text-[11px] text-slate-300"><%= user ? user.email : 'admin' %></span>
        </div>
        <a href="/auth/logout" class="bg-slate-800 hover:bg-rose-950/50 hover:text-rose-300 hover:border-rose-800/60 text-slate-300 text-xs font-medium px-3.5 py-1.5 rounded-lg border border-slate-700/70 transition-all flex items-center gap-1.5">
          <i class="fa-solid fa-arrow-right-from-bracket text-[11px]"></i>
          <span>Sign Out</span>
        </a>
      </div>
    </div>
  </header>

  <!-- Main Content Container -->
  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">

    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-800">
      <div>
        <div class="flex items-center gap-3">
          <h1 class="text-2xl font-bold text-white tracking-tight">Security & Audit Logs</h1>
          <span class="bg-indigo-950/70 text-indigo-300 border border-indigo-800/60 text-[11px] font-semibold px-2.5 py-0.5 rounded-full font-mono tabular-nums">
            <%= logs.length %> Records
          </span>
        </div>
        <p class="text-xs text-slate-400 mt-1">Chronological trail of administrative mutations, trial grants, plan activations, and entitlement revokes</p>
      </div>
    </div>

    <!-- Audit Log Table Card -->
    <div class="bg-slate-900/60 border border-slate-800 rounded-2xl shadow-xl overflow-hidden backdrop-blur-sm">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs border-collapse">
          <thead>
            <tr class="bg-slate-900/95 border-b border-slate-800 text-slate-400 uppercase tracking-wider font-semibold text-[11px]">
              <th class="py-3.5 px-4">Timestamp (UTC / Local)</th>
              <th class="py-3.5 px-4">Action Token</th>
              <th class="py-3.5 px-4">Target Institute</th>
              <th class="py-3.5 px-4">Operator UID</th>
              <th class="py-3.5 px-4">Reason & Parameters</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800/80">
            <% if (logs.length === 0) { %>
              <tr>
                <td colspan="5" class="py-12 text-center text-slate-500">
                  <div class="flex flex-col items-center justify-center space-y-3">
                    <div class="w-12 h-12 rounded-full bg-slate-900 flex items-center justify-center border border-slate-800 text-slate-600">
                      <i class="fa-solid fa-shield-halved text-lg"></i>
                    </div>
                    <div>
                      <p class="font-medium text-slate-400">No audit logs recorded</p>
                      <p class="text-[11px] text-slate-600 mt-0.5">Administrative operations will automatically be appended here</p>
                    </div>
                  </div>
                </td>
              </tr>
            <% } %>

            <% logs.forEach(l => { %>
              <tr class="hover:bg-slate-800/30 transition-colors">
                <td class="py-4 px-4 align-top font-mono text-[11px] text-slate-400 tabular-nums">
                  <%= l.timestamp ? new Date(l.timestamp).toLocaleString() : '-' %>
                </td>
                <td class="py-4 px-4 align-top">
                  <% const act = l.action || ''; %>
                  <% if (act.includes('ACTIVATED') || act.includes('GRANTED')) { %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[10px] font-mono font-medium bg-emerald-950/70 text-emerald-300 border border-emerald-800/60">
                      <%= act %>
                    </span>
                  <% } else if (act.includes('REVOKED')) { %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[10px] font-mono font-medium bg-rose-950/70 text-rose-300 border border-rose-800/60">
                      <%= act %>
                    </span>
                  <% } else if (act.includes('EXTENDED')) { %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[10px] font-mono font-medium bg-indigo-950/70 text-indigo-300 border border-indigo-800/60">
                      <%= act %>
                    </span>
                  <% } else { %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[10px] font-mono font-medium bg-slate-800 text-slate-300 border border-slate-700">
                      <%= act %>
                    </span>
                  <% } %>
                </td>
                <td class="py-4 px-4 align-top font-mono text-[11px] text-slate-300">
                  <% if (l.instituteId && l.instituteId !== 'unknown') { %>
                    <a href="/institutes?search=<%= l.instituteId %>" class="hover:text-indigo-300 underline decoration-slate-700 underline-offset-2">
                      <%= l.instituteId %>
                    </a>
                  <% } else { %>
                    <span class="text-slate-500">-</span>
                  <% } %>
                </td>
                <td class="py-4 px-4 align-top font-mono text-[11px] text-slate-400">
                  <%= l.performedBy || 'system' %>
                </td>
                <td class="py-4 px-4 align-top text-slate-300 text-xs">
                  <div><%= l.reason || '-' %></div>
                  <% if (l.planTier) { %>
                    <span class="text-[10px] text-slate-500 mt-0.5 block">Plan: <%= l.planTier %><%= l.isLifetime ? ' (Lifetime)' : '' %></span>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>

  </main>
</body>
</html>
