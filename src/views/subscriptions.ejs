<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — RyuBreed Academia Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; }
    .font-mono { font-family: 'JetBrains Mono', monospace; }
  </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col antialiased selection:bg-indigo-500 selection:text-white">

  <!-- Top Navigation Bar -->
  <header class="bg-slate-900/90 backdrop-blur-md border-b border-slate-800 sticky top-0 z-40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <div class="flex items-center space-x-6">
        <a href="/" class="flex items-center space-x-3 group">
          <div class="w-8 h-8 rounded-lg bg-indigo-600 flex items-center justify-center font-bold text-white text-sm">
            R
          </div>
          <div>
            <span class="text-sm font-semibold text-white tracking-tight block leading-tight">RyuBreed Academia</span>
            <span class="text-[10px] font-medium text-slate-400 block">Admin Hub</span>
          </div>
        </a>

        <nav class="hidden md:flex items-center space-x-1 pl-6 border-l border-slate-800">
          <a href="/" class="px-3 py-1.5 rounded-lg text-xs font-medium text-slate-400 hover:text-white hover:bg-slate-800/60 transition-colors">
            <i class="fa-solid fa-chart-pie mr-1.5 text-slate-500"></i>Dashboard
          </a>
          <a href="/institutes" class="px-3 py-1.5 rounded-lg text-xs font-medium text-slate-400 hover:text-white hover:bg-slate-800/60 transition-colors">
            <i class="fa-solid fa-building-columns mr-1.5 text-slate-500"></i>Institutes
          </a>
          <a href="/subscriptions" class="px-3 py-1.5 rounded-lg text-xs font-medium text-white bg-slate-800 border border-slate-700/60 transition-colors">
            <i class="fa-solid fa-credit-card mr-1.5 text-indigo-400"></i>Subscriptions
          </a>
          <a href="/audit" class="px-3 py-1.5 rounded-lg text-xs font-medium text-slate-400 hover:text-white hover:bg-slate-800/60 transition-colors">
            <i class="fa-solid fa-shield-halved mr-1.5 text-slate-500"></i>Audit Logs
          </a>
        </nav>
      </div>

      <div class="flex items-center space-x-3">
        <div class="hidden sm:flex items-center space-x-2 bg-slate-900 border border-slate-800 px-3 py-1 rounded-lg text-xs text-slate-300">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          <span class="font-mono text-[11px] text-slate-300"><%= user ? user.email : 'admin' %></span>
        </div>
        <a href="/auth/logout" class="bg-slate-800 hover:bg-rose-950/50 hover:text-rose-300 hover:border-rose-800/60 text-slate-300 text-xs font-medium px-3.5 py-1.5 rounded-lg border border-slate-700/70 transition-all flex items-center gap-1.5">
          <i class="fa-solid fa-arrow-right-from-bracket text-[11px]"></i>
          <span>Sign Out</span>
        </a>
      </div>
    </div>
  </header>

  <!-- Main Content Container -->
  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">

    <!-- Flash Notices -->
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="p-4 bg-emerald-950/50 border border-emerald-800/80 rounded-xl text-emerald-200 text-xs flex items-center gap-3 shadow-lg">
        <i class="fa-solid fa-circle-check text-emerald-400 text-sm"></i>
        <span class="font-medium"><%= success %></span>
      </div>
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="p-4 bg-rose-950/50 border border-rose-800/80 rounded-xl text-rose-200 text-xs flex items-center gap-3 shadow-lg">
        <i class="fa-solid fa-circle-exclamation text-rose-400 text-sm"></i>
        <span class="font-medium"><%= error %></span>
      </div>
    <% } %>

    <!-- Page Header & Filter -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-800">
      <div>
        <div class="flex items-center gap-3">
          <h1 class="text-2xl font-bold text-white tracking-tight">Subscription Ledger</h1>
          <span class="bg-indigo-950/70 text-indigo-300 border border-indigo-800/60 text-[11px] font-semibold px-2.5 py-0.5 rounded-full font-mono tabular-nums">
            <%= subscriptions.length %> Total
          </span>
        </div>
        <p class="text-xs text-slate-400 mt-1">Tenant cloud entitlements, billing periods, and license validity windows</p>
      </div>

      <form action="/subscriptions" method="GET" class="flex items-center gap-2">
        <label for="statusFilter" class="text-xs text-slate-400 font-medium">Filter:</label>
        <select 
          id="statusFilter"
          name="status" 
          onchange="this.form.submit()" 
          class="bg-slate-900 border border-slate-700/80 text-xs text-white rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500/50"
        >
          <option value="all" <%= statusFilter === 'all' ? 'selected' : '' %>>All Statuses</option>
          <option value="active" <%= statusFilter === 'active' ? 'selected' : '' %>>Active</option>
          <option value="trial" <%= statusFilter === 'trial' ? 'selected' : '' %>>Pilot / Trial</option>
          <option value="expired" <%= statusFilter === 'expired' ? 'selected' : '' %>>Expired</option>
          <option value="revoked" <%= statusFilter === 'revoked' ? 'selected' : '' %>>Revoked</option>
        </select>
      </form>
    </div>

    <!-- Table Card -->
    <div class="bg-slate-900/60 border border-slate-800 rounded-2xl shadow-xl overflow-hidden backdrop-blur-sm">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs border-collapse">
          <thead>
            <tr class="bg-slate-900/95 border-b border-slate-800 text-slate-400 uppercase tracking-wider font-semibold text-[11px]">
              <th class="py-3.5 px-4">Subscription ID</th>
              <th class="py-3.5 px-4">Institute UID</th>
              <th class="py-3.5 px-4">Plan Tier</th>
              <th class="py-3.5 px-4">Status</th>
              <th class="py-3.5 px-4">Amount</th>
              <th class="py-3.5 px-4">Valid Until</th>
              <th class="py-3.5 px-4 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800/80">
            <% if (subscriptions.length === 0) { %>
              <tr>
                <td colspan="7" class="py-12 text-center text-slate-500">
                  <div class="flex flex-col items-center justify-center space-y-3">
                    <div class="w-12 h-12 rounded-full bg-slate-900 flex items-center justify-center border border-slate-800 text-slate-600">
                      <i class="fa-solid fa-credit-card text-lg"></i>
                    </div>
                    <div>
                      <p class="font-medium text-slate-400">No subscriptions found</p>
                      <p class="text-[11px] text-slate-600 mt-0.5">There are no records matching the selected status filter</p>
                    </div>
                  </div>
                </td>
              </tr>
            <% } %>

            <% subscriptions.forEach(s => { %>
              <tr class="hover:bg-slate-800/30 transition-colors">
                <td class="py-4 px-4 align-top font-mono text-[11px] text-slate-300">
                  <%= s.id %>
                </td>
                <td class="py-4 px-4 align-top font-mono text-[11px] text-slate-400">
                  <a href="/institutes?search=<%= s.instituteId %>" class="hover:text-indigo-300 underline decoration-slate-700 underline-offset-2">
                    <%= s.instituteId %>
                  </a>
                </td>
                <td class="py-4 px-4 align-top">
                  <% const plan = (s.planName || s.planId || '').toLowerCase(); %>
                  <% if (s.isLifetime) { %>
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[10px] font-semibold bg-amber-950/70 text-amber-300 border border-amber-800/60">
                      <i class="fa-solid fa-crown text-[9px]"></i>Lifetime
                    </span>
                  <% } else if (plan.includes('smart') || plan === 'smart199') { %>
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[10px] font-semibold bg-indigo-950/70 text-indigo-300 border border-indigo-800/60">
                      Smart ₹199
                    </span>
                  <% } else if (plan.includes('core') || plan === 'core99') { %>
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[10px] font-semibold bg-sky-950/70 text-sky-300 border border-sky-800/60">
                      Core ₹99
                    </span>
                  <% } else { %>
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[10px] font-medium bg-slate-800 text-slate-400 border border-slate-700">
                      <%= s.planName || s.planId || 'Standard' %>
                    </span>
                  <% } %>
                </td>
                <td class="py-4 px-4 align-top">
                  <% if (s.status === 'active') { %>
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-semibold bg-emerald-950/80 text-emerald-300 border border-emerald-800/80">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>Active
                    </span>
                  <% } else if (s.status === 'trial') { %>
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-semibold bg-indigo-950/80 text-indigo-300 border border-indigo-800/80">
                      <span class="w-1.5 h-1.5 rounded-full bg-indigo-400"></span>Trial
                    </span>
                  <% } else if (s.status === 'revoked') { %>
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-semibold bg-rose-950/80 text-rose-300 border border-rose-800/80">
                      Revoked
                    </span>
                  <% } else { %>
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-semibold bg-slate-800/90 text-slate-400 border border-slate-700">
                      Expired
                    </span>
                  <% } %>
                </td>
                <td class="py-4 px-4 align-top font-mono tabular-nums text-slate-200">
                  ₹<%= (s.amount || 0).toLocaleString('en-IN') %>
                </td>
                <td class="py-4 px-4 align-top font-mono tabular-nums text-slate-300">
                  <% if (s.isLifetime) { %>
                    <span class="text-amber-300">Never (Lifetime)</span>
                  <% } else if (s.endAt) { %>
                    <%= new Date(s.endAt).toLocaleDateString() %>
                  <% } else { %>
                    <span class="text-slate-500">-</span>
                  <% } %>
                </td>
                <td class="py-4 px-4 align-top text-right">
                  <button 
                    onclick="openExtendModal('<%= s.id %>')" 
                    class="bg-emerald-600/20 hover:bg-emerald-600/40 text-emerald-300 border border-emerald-700/60 px-3 py-1.5 rounded-lg text-xs font-medium transition-colors"
                  >
                    Extend
                  </button>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>

  </main>

  <!-- Extend Modal -->
  <div id="extendModal" class="hidden fixed inset-0 bg-slate-950/80 backdrop-blur-md flex items-center justify-center p-4 z-50">
    <div class="bg-slate-900 border border-slate-700 rounded-2xl max-w-md w-full p-6 shadow-2xl relative">
      <button onclick="closeExtendModal()" class="absolute top-4 right-4 text-slate-400 hover:text-white text-base">
        <i class="fa-solid fa-xmark"></i>
      </button>

      <div class="flex items-center gap-3 mb-4">
        <div class="w-10 h-10 rounded-xl bg-emerald-950 border border-emerald-800/80 flex items-center justify-center text-emerald-400">
          <i class="fa-solid fa-clock-rotate-left text-base"></i>
        </div>
        <div>
          <h3 class="text-base font-bold text-white">Extend Subscription</h3>
          <p class="text-xs text-slate-400">Subscription: <span id="extendSubDisplay" class="font-mono text-slate-300"></span></p>
        </div>
      </div>

      <form action="/subscriptions/extend" method="POST" class="space-y-4">
        <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>" />
        <input type="hidden" id="extendSubId" name="subscriptionId" value="" />

        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1.5">Additional Days</label>
          <select name="days" class="bg-slate-950 border border-slate-700 text-xs text-white rounded-xl p-3 w-full focus:outline-none focus:ring-2 focus:ring-emerald-500">
            <option value="30">30 Days (1 Month Extension)</option>
            <option value="60">60 Days (2 Months Extension)</option>
            <option value="90">90 Days (Quarterly Extension)</option>
            <option value="180">180 Days (Half Year)</option>
            <option value="365">365 Days (1 Full Year)</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1.5">Administrative Reason</label>
          <input 
            type="text" 
            name="reason" 
            placeholder="e.g. Authorized customer support contract adjustment" 
            required 
            class="bg-slate-950 border border-slate-700 text-xs text-white rounded-xl p-3 w-full focus:outline-none focus:ring-2 focus:ring-emerald-500 placeholder:text-slate-500" 
          />
        </div>

        <div class="flex justify-end gap-2.5 pt-4 border-t border-slate-800">
          <button type="button" onclick="closeExtendModal()" class="px-4 py-2.5 text-xs font-semibold text-slate-400 hover:text-white rounded-xl">Cancel</button>
          <button type="submit" class="bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-semibold px-5 py-2.5 rounded-xl shadow-lg shadow-emerald-600/30">
            Confirm Extension
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    function openExtendModal(id) {
      document.getElementById('extendSubId').value = id;
      document.getElementById('extendSubDisplay').textContent = id;
      document.getElementById('extendModal').classList.remove('hidden');
    }
    function closeExtendModal() {
      document.getElementById('extendModal').classList.add('hidden');
    }
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeExtendModal();
      }
    });
  </script>
</body>
</html>
