<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — RyuBreed Academia Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; }
    .font-mono { font-family: 'JetBrains Mono', monospace; }
  </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col antialiased selection:bg-indigo-500 selection:text-white">

  <!-- Top Navigation Bar -->
  <header class="bg-slate-900/90 backdrop-blur-md border-b border-slate-800 sticky top-0 z-40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <div class="flex items-center space-x-6">
        <a href="/" class="flex items-center space-x-3 group">
          <div class="w-8 h-8 rounded-lg bg-indigo-600 flex items-center justify-center font-bold text-white text-sm">
            R
          </div>
          <div>
            <span class="text-sm font-semibold text-white tracking-tight block leading-tight">RyuBreed Academia</span>
            <span class="text-[10px] font-medium text-slate-400 block">Admin Hub</span>
          </div>
        </a>

        <nav class="hidden md:flex items-center space-x-1 pl-6 border-l border-slate-800">
          <a href="/" class="px-3 py-1.5 rounded-lg text-xs font-medium text-slate-400 hover:text-white hover:bg-slate-800/60 transition-colors">
            <i class="fa-solid fa-chart-pie mr-1.5 text-slate-500"></i>Dashboard
          </a>
          <a href="/institutes" class="px-3 py-1.5 rounded-lg text-xs font-medium text-white bg-slate-800 border border-slate-700/60 transition-colors">
            <i class="fa-solid fa-building-columns mr-1.5 text-indigo-400"></i>Institutes
          </a>
          <a href="/subscriptions" class="px-3 py-1.5 rounded-lg text-xs font-medium text-slate-400 hover:text-white hover:bg-slate-800/60 transition-colors">
            <i class="fa-solid fa-credit-card mr-1.5 text-slate-500"></i>Subscriptions
          </a>
          <a href="/audit" class="px-3 py-1.5 rounded-lg text-xs font-medium text-slate-400 hover:text-white hover:bg-slate-800/60 transition-colors">
            <i class="fa-solid fa-shield-halved mr-1.5 text-slate-500"></i>Audit Logs
          </a>
        </nav>
      </div>

      <div class="flex items-center space-x-3">
        <div class="hidden sm:flex items-center space-x-2 bg-slate-900 border border-slate-800 px-3 py-1 rounded-lg text-xs text-slate-300">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          <span class="font-mono text-[11px] text-slate-300"><%= user ? user.email : 'admin' %></span>
        </div>
        <a href="/auth/logout" class="bg-slate-800 hover:bg-rose-950/50 hover:text-rose-300 hover:border-rose-800/60 text-slate-300 text-xs font-medium px-3.5 py-1.5 rounded-lg border border-slate-700/70 transition-all flex items-center gap-1.5">
          <i class="fa-solid fa-arrow-right-from-bracket text-[11px]"></i>
          <span>Sign Out</span>
        </a>
      </div>
    </div>
  </header>

  <!-- Main Content Container (Full Width Balanced Grid) -->
  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">

    <!-- Flash / Query Notices -->
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="p-4 bg-emerald-950/50 border border-emerald-800/80 rounded-xl text-emerald-200 text-xs flex items-center gap-3 shadow-lg">
        <i class="fa-solid fa-circle-check text-emerald-400 text-sm"></i>
        <span class="font-medium"><%= success %></span>
      </div>
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="p-4 bg-rose-950/50 border border-rose-800/80 rounded-xl text-rose-200 text-xs flex items-center gap-3 shadow-lg">
        <i class="fa-solid fa-circle-exclamation text-rose-400 text-sm"></i>
        <span class="font-medium"><%= error %></span>
      </div>
    <% } %>
    <% if (typeof connectionWarning !== 'undefined' && connectionWarning) { %>
      <div class="p-4 bg-amber-950/50 border border-amber-800/80 rounded-xl text-amber-200 text-xs flex items-center gap-3 shadow-lg">
        <i class="fa-solid fa-triangle-exclamation text-amber-400 text-sm"></i>
        <div>
          <span class="font-semibold text-amber-300">Database Connection Notice:</span>
          <span class="text-amber-200/90 ml-1"><%= connectionWarning %></span>
        </div>
      </div>
    <% } %>

    <!-- Page Header & Action Bar -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-4 border-b border-slate-800/80">
      <div>
        <div class="flex items-center gap-3">
          <h1 class="text-2xl font-bold text-white tracking-tight">Institute Directory</h1>
          <span class="bg-indigo-950/70 text-indigo-300 border border-indigo-800/60 text-[11px] font-semibold px-2.5 py-0.5 rounded-full">
            <%= institutes.length %> Registered
          </span>
        </div>
        <p class="text-xs text-slate-400 mt-1">Manage tenant profiles, cloud licensing entitlements, and administrative privileges</p>
      </div>

      <!-- Search Box -->
      <form action="/institutes" method="GET" class="flex items-center gap-2 w-full md:w-auto">
        <div class="relative w-full md:w-80">
          <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-500 text-xs"></i>
          <input 
            type="text" 
            name="search" 
            value="<%= search || '' %>" 
            placeholder="Search by institute name, email, or UID..." 
            class="w-full bg-slate-900 border border-slate-700/80 text-xs text-white rounded-xl pl-8 pr-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-indigo-500/50 focus:border-indigo-500 transition-all placeholder:text-slate-500"
          />
        </div>
        <button type="submit" class="bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold px-4 py-2.5 rounded-xl shadow-md shadow-indigo-600/20 transition-all flex items-center gap-1.5 shrink-0">
          <span>Search</span>
        </button>
        <% if (search) { %>
          <a href="/institutes" class="bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs px-3 py-2.5 rounded-xl border border-slate-700 transition-colors shrink-0" title="Clear search">
            <i class="fa-solid fa-xmark"></i>
          </a>
        <% } %>
      </form>
    </div>

    <!-- Institutes Table Card -->
    <div class="bg-slate-900/60 border border-slate-800 rounded-2xl shadow-xl overflow-hidden backdrop-blur-sm">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs border-collapse">
          <thead>
            <tr class="bg-slate-900/95 border-b border-slate-800 text-slate-400 uppercase tracking-wider font-semibold text-[11px]">
              <th class="py-3.5 px-4">Institute & Identifier</th>
              <th class="py-3.5 px-4">Contact Profile</th>
              <th class="py-3.5 px-4">Academic Footprint</th>
              <th class="py-3.5 px-4">Plan Tier</th>
              <th class="py-3.5 px-4">License Status</th>
              <th class="py-3.5 px-4">Expiry / Renewal</th>
              <th class="py-3.5 px-4 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800/80">
            <% if (institutes.length === 0) { %>
              <tr>
                <td colspan="7" class="py-12 text-center text-slate-500">
                  <div class="flex flex-col items-center justify-center space-y-3">
                    <div class="w-12 h-12 rounded-full bg-slate-900 flex items-center justify-center border border-slate-800 text-slate-600">
                      <i class="fa-solid fa-building-circle-exclamation text-lg"></i>
                    </div>
                    <div>
                      <p class="font-medium text-slate-400">No institutes found</p>
                      <p class="text-[11px] text-slate-600 mt-0.5">Try adjusting your search criteria or register a new institute</p>
                    </div>
                  </div>
                </td>
              </tr>
            <% } %>

            <% institutes.forEach(inst => { %>
              <tr class="hover:bg-slate-800/30 transition-colors group">
                <!-- Institute Name & ID -->
                <td class="py-4 px-4 align-top">
                  <div class="font-semibold text-white text-sm tracking-tight flex items-center gap-2">
                    <span><%= inst.name || 'Unnamed Institute' %></span>
                    <% if (inst.isLifetime) { %>
                      <span class="inline-flex items-center text-[10px] font-semibold text-amber-300 bg-amber-950/70 border border-amber-800/60 px-1.5 py-0.2 rounded" title="Lifetime Subscription Active">
                        <i class="fa-solid fa-crown text-[9px] mr-1"></i>Lifetime
                      </span>
                    <% } %>
                  </div>
                  <div class="mt-1 flex items-center gap-1.5">
                    <span class="font-mono text-[10px] text-slate-400 bg-slate-950 px-2 py-0.5 rounded border border-slate-800" title="Institute UID">
                      <%= inst.id %>
                    </span>
                    <% if (inst.licenseKey) { %>
                      <span class="font-mono text-[9px] text-indigo-400/80 bg-indigo-950/50 px-1.5 py-0.5 rounded border border-indigo-900/40" title="Active License Key">
                        <%= inst.licenseKey %>
                      </span>
                    <% } %>
                  </div>
                </td>

                <!-- Contact Profile -->
                <td class="py-4 px-4 align-top text-slate-300">
                  <div class="flex items-center gap-1.5 text-slate-200">
                    <i class="fa-regular fa-envelope text-slate-500 text-[11px]"></i>
                    <span><%= inst.email || '-' %></span>
                  </div>
                  <% if (inst.phone) { %>
                    <div class="flex items-center gap-1.5 text-slate-400 text-[11px] mt-1 font-mono">
                      <i class="fa-solid fa-phone text-slate-600 text-[10px]"></i>
                      <span><%= inst.phone %></span>
                    </div>
                  <% } %>
                </td>

                <!-- Academic Footprint (Students & Batches) -->
                <td class="py-4 px-4 align-top">
                  <div class="flex items-center gap-3">
                    <div class="flex items-center gap-1.5 text-slate-300" title="Enrolled Students">
                      <div class="w-6 h-6 rounded-md bg-indigo-950/60 border border-indigo-900/50 flex items-center justify-center text-indigo-400 text-[10px]">
                        <i class="fa-solid fa-user-graduate"></i>
                      </div>
                      <span class="font-semibold text-white"><%= inst.studentsCount || 0 %></span>
                      <span class="text-[10px] text-slate-500">students</span>
                    </div>

                    <div class="flex items-center gap-1.5 text-slate-300" title="Active Batches">
                      <div class="w-6 h-6 rounded-md bg-sky-950/60 border border-sky-900/50 flex items-center justify-center text-sky-400 text-[10px]">
                        <i class="fa-solid fa-layer-group"></i>
                      </div>
                      <span class="font-semibold text-white"><%= inst.batchesCount || 0 %></span>
                      <span class="text-[10px] text-slate-500">batches</span>
                    </div>
                  </div>
                </td>

                <!-- Plan Tier -->
                <td class="py-4 px-4 align-top">
                  <% if (inst.planTier === 'smart199') { %>
                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-[11px] font-semibold bg-indigo-950/70 text-indigo-300 border border-indigo-700/60">
                      <i class="fa-solid fa-bolt text-indigo-400 text-[10px]"></i>Smart ₹199
                    </span>
                  <% } else if (inst.planTier === 'core99') { %>
                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-[11px] font-semibold bg-sky-950/70 text-sky-300 border border-sky-700/60">
                      <i class="fa-solid fa-cube text-sky-400 text-[10px]"></i>Core ₹99
                    </span>
                  <% } else if (inst.isLifetime) { %>
                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-[11px] font-semibold bg-amber-950/70 text-amber-300 border border-amber-700/60">
                      <i class="fa-solid fa-infinity text-amber-400 text-[10px]"></i>Lifetime
                    </span>
                  <% } else { %>
                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-[11px] font-semibold bg-slate-800 text-slate-400 border border-slate-700">
                      Free Tier
                    </span>
                  <% } %>
                </td>

                <!-- License Status -->
                <td class="py-4 px-4 align-top">
                  <% const st = inst.licenseStatus || inst.subscriptionStatus; %>
                  <% if (st === 'active') { %>
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-semibold bg-emerald-950/80 text-emerald-300 border border-emerald-800/80">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>Active
                    </span>
                  <% } else if (st === 'trial') { %>
                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10px] font-bold bg-blue-950/80 text-blue-300 border border-blue-700/80">
                      <span class="w-1.5 h-1.5 rounded-full bg-blue-400"></span>TRIAL
                    </span>
                  <% } else if (st === 'revoked') { %>
                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10px] font-bold bg-rose-950/80 text-rose-300 border border-rose-800/80">
                      <i class="fa-solid fa-ban text-[9px]"></i>REVOKED
                    </span>
                  <% } else { %>
                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10px] font-bold bg-slate-800/90 text-slate-400 border border-slate-700">
                      <span class="w-1.5 h-1.5 rounded-full bg-slate-500"></span>EXPIRED
                    </span>
                  <% } %>
                </td>

                <!-- Expiry Date -->
                <td class="py-4 px-4 align-top">
                  <div class="text-slate-300 font-medium">
                    <% if (inst.isLifetime) { %>
                      <span class="text-amber-300 font-semibold">Never (Lifetime)</span>
                    <% } else if (inst.validUntil) { %>
                      <span class="font-mono text-[11px]"><%= new Date(inst.validUntil).toLocaleDateString() %></span>
                    <% } else if (inst.trialEndsAt) { %>
                      <span class="font-mono text-[11px]"><%= new Date(inst.trialEndsAt).toLocaleDateString() %></span>
                    <% } else { %>
                      <span class="text-slate-500">-</span>
                    <% } %>
                  </div>
                  <div class="text-[10px] text-slate-500 mt-0.5">
                    <%= inst.trialUsed ? 'Trial Consumed' : 'Trial Eligible' %>
                  </div>
                </td>

                <!-- Actions -->
                <td class="py-4 px-4 align-top text-right space-x-1.5 shrink-0">
                  <button 
                    onclick="openGrantModal('<%= inst.id %>', '<%= (inst.name || '').replace(/'/g, '\\\'') %>')" 
                    class="bg-indigo-600/20 hover:bg-indigo-600/40 text-indigo-300 border border-indigo-700/60 px-2.5 py-1.5 rounded-lg text-[11px] font-medium transition-colors"
                    title="Grant trial access"
                  >
                    <i class="fa-solid fa-gift mr-1 text-[10px]"></i>Trial
                  </button>

                  <button 
                    onclick="openPlanModal('<%= inst.id %>', '<%= (inst.name || '').replace(/'/g, '\\\'') %>', '<%= inst.planTier || 'smart199' %>')" 
                    class="bg-emerald-600/20 hover:bg-emerald-600/40 text-emerald-300 border border-emerald-700/60 px-2.5 py-1.5 rounded-lg text-[11px] font-medium transition-colors"
                    title="Activate or upgrade subscription plan"
                  >
                    <i class="fa-solid fa-wand-magic-sparkles mr-1 text-[10px]"></i>Plan
                  </button>

                  <button 
                    onclick="openRevokeModal('<%= inst.id %>', '<%= (inst.name || '').replace(/'/g, '\\\'') %>')" 
                    class="bg-rose-900/20 hover:bg-rose-900/40 text-rose-300 border border-rose-800/60 px-2.5 py-1.5 rounded-lg text-[11px] font-medium transition-colors"
                    title="Revoke cloud entitlement"
                  >
                    <i class="fa-solid fa-ban mr-1 text-[10px]"></i>Revoke
                  </button>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>

  </main>

  <!-- Grant Trial Modal -->
  <div id="grantModal" class="hidden fixed inset-0 bg-slate-950/80 backdrop-blur-md flex items-center justify-center p-4 z-50 transition-opacity">
    <div class="bg-slate-900 border border-slate-700 rounded-2xl max-w-md w-full p-6 shadow-2xl relative">
      <button onclick="closeGrantModal()" class="absolute top-4 right-4 text-slate-400 hover:text-white text-base">
        <i class="fa-solid fa-xmark"></i>
      </button>

      <div class="flex items-center gap-3 mb-4">
        <div class="w-10 h-10 rounded-xl bg-indigo-950 border border-indigo-800/80 flex items-center justify-center text-indigo-400">
          <i class="fa-solid fa-gift text-base"></i>
        </div>
        <div>
          <h3 class="text-base font-bold text-white">Grant Free Trial</h3>
          <p class="text-xs text-slate-400">Target: <span id="grantInstName" class="font-semibold text-slate-300"></span></p>
        </div>
      </div>

      <form action="/trials/grant" method="POST" class="space-y-4">
        <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>" />
        <input type="hidden" id="grantInstId" name="instituteId" value="" />

        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1.5">Trial Duration</label>
          <select name="durationDays" class="bg-slate-950 border border-slate-700 text-xs text-white rounded-xl p-3 w-full focus:outline-none focus:ring-2 focus:ring-indigo-500">
            <option value="0.0416667">1 Hour (Rapid Expiry & Alert Testing)</option>
            <option value="0.5">12 Hours (Half-Day Pilot)</option>
            <option value="1">1 Day (24-Hour Evaluation)</option>
            <option value="3">3 Days (Quick Evaluation)</option>
            <option value="7" selected>7 Days (Standard Trial)</option>
            <option value="14">14 Days (Extended Evaluation)</option>
            <option value="30">30 Days (1 Month Evaluation)</option>
            <option value="60">60 Days (2 Months Pilot)</option>
            <option value="90">90 Days (Quarterly Pilot)</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1.5">Administrative Audit Reason</label>
          <input 
            type="text" 
            name="reason" 
            placeholder="e.g. Authorized onboard pilot for institutional demo" 
            required 
            class="bg-slate-950 border border-slate-700 text-xs text-white rounded-xl p-3 w-full focus:outline-none focus:ring-2 focus:ring-indigo-500 placeholder:text-slate-500" 
          />
        </div>

        <div class="flex justify-end gap-2.5 pt-4 border-t border-slate-800">
          <button type="button" onclick="closeGrantModal()" class="px-4 py-2.5 text-xs font-semibold text-slate-400 hover:text-white rounded-xl">Cancel</button>
          <button type="submit" class="bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold px-5 py-2.5 rounded-xl shadow-lg shadow-indigo-600/30">
            Confirm & Unlock Trial
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Set / Activate Plan Modal -->
  <div id="planModal" class="hidden fixed inset-0 bg-slate-950/80 backdrop-blur-md flex items-center justify-center p-4 z-50 transition-opacity">
    <div class="bg-slate-900 border border-slate-700 rounded-2xl max-w-md w-full p-6 shadow-2xl relative">
      <button onclick="closePlanModal()" class="absolute top-4 right-4 text-slate-400 hover:text-white text-base">
        <i class="fa-solid fa-xmark"></i>
      </button>

      <div class="flex items-center gap-3 mb-4">
        <div class="w-10 h-10 rounded-xl bg-emerald-950 border border-emerald-800/80 flex items-center justify-center text-emerald-400">
          <i class="fa-solid fa-wand-magic-sparkles text-base"></i>
        </div>
        <div>
          <h3 class="text-base font-bold text-white">Set Subscription Plan</h3>
          <p class="text-xs text-slate-400">Target: <span id="planInstName" class="font-semibold text-slate-300"></span></p>
        </div>
      </div>

      <form action="/plans/activate" method="POST" class="space-y-4">
        <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>" />
        <input type="hidden" id="planInstId" name="instituteId" value="" />

        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1.5">Select Plan Tier</label>
          <select id="planTierSelect" name="planTier" class="bg-slate-950 border border-slate-700 text-xs text-white rounded-xl p-3 w-full focus:outline-none focus:ring-2 focus:ring-indigo-500">
            <option value="smart199">Smart Plan (₹199/month - All Features & Unlimited)</option>
            <option value="core99">Core Plan (₹99/month - Essential Sync)</option>
            <option value="lifetime">Lifetime Unlimited Access (Admin Override)</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1.5">Validity Duration</label>
          <select name="durationMonths" class="bg-slate-950 border border-slate-700 text-xs text-white rounded-xl p-3 w-full focus:outline-none focus:ring-2 focus:ring-indigo-500">
            <option value="1">1 Month</option>
            <option value="3">3 Months</option>
            <option value="6">6 Months</option>
            <option value="12" selected>12 Months (1 Year)</option>
            <option value="120">10 Years</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1.5">Reason / Authorization Notes</label>
          <input 
            type="text" 
            name="reason" 
            placeholder="e.g. Annual institutional contract activation" 
            required 
            class="bg-slate-950 border border-slate-700 text-xs text-white rounded-xl p-3 w-full focus:outline-none focus:ring-2 focus:ring-indigo-500 placeholder:text-slate-500" 
          />
        </div>

        <div class="flex justify-end gap-2.5 pt-4 border-t border-slate-800">
          <button type="button" onclick="closePlanModal()" class="px-4 py-2.5 text-xs font-semibold text-slate-400 hover:text-white rounded-xl">Cancel</button>
          <button type="submit" class="bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-semibold px-5 py-2.5 rounded-xl shadow-lg shadow-emerald-600/30">
            Activate & Synchronize
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Revoke Modal -->
  <div id="revokeModal" class="hidden fixed inset-0 bg-slate-950/80 backdrop-blur-md flex items-center justify-center p-4 z-50 transition-opacity">
    <div class="bg-slate-900 border border-slate-700 rounded-2xl max-w-md w-full p-6 shadow-2xl relative">
      <button onclick="closeRevokeModal()" class="absolute top-4 right-4 text-slate-400 hover:text-white text-base">
        <i class="fa-solid fa-xmark"></i>
      </button>

      <div class="flex items-center gap-3 mb-4">
        <div class="w-10 h-10 rounded-xl bg-rose-950 border border-rose-800/80 flex items-center justify-center text-rose-400">
          <i class="fa-solid fa-triangle-exclamation text-base"></i>
        </div>
        <div>
          <h3 class="text-base font-bold text-white">Revoke Subscription Access</h3>
          <p class="text-xs text-slate-400">Target: <span id="revokeInstName" class="font-semibold text-slate-300"></span></p>
        </div>
      </div>

      <p class="text-xs text-slate-400 mb-4 bg-rose-950/30 border border-rose-900/50 p-3 rounded-xl leading-relaxed">
        Revoking will immediately mark the license as <strong class="text-rose-300">REVOKED</strong> in Firestore. The Flutter app will instantly halt cloud synchronization and notify the institute administrator upon opening.
      </p>

      <form action="/subscriptions/revoke" method="POST" class="space-y-4">
        <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>" />
        <input type="hidden" id="revokeInstId" name="instituteId" value="" />

        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1.5">Revocation Reason</label>
          <input 
            type="text" 
            name="reason" 
            placeholder="e.g. Terms violation or billing non-payment" 
            required 
            class="bg-slate-950 border border-slate-700 text-xs text-white rounded-xl p-3 w-full focus:outline-none focus:ring-2 focus:ring-rose-500 placeholder:text-slate-500" 
          />
        </div>

        <div class="flex justify-end gap-2.5 pt-4 border-t border-slate-800">
          <button type="button" onclick="closeRevokeModal()" class="px-4 py-2.5 text-xs font-semibold text-slate-400 hover:text-white rounded-xl">Cancel</button>
          <button type="submit" class="bg-rose-600 hover:bg-rose-500 text-white text-xs font-semibold px-5 py-2.5 rounded-xl shadow-lg shadow-rose-600/30">
            Confirm Revocation
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    function openGrantModal(id, name) {
      document.getElementById('grantInstId').value = id;
      document.getElementById('grantInstName').textContent = name || id;
      document.getElementById('grantModal').classList.remove('hidden');
    }
    function closeGrantModal() {
      document.getElementById('grantModal').classList.add('hidden');
    }

    function openPlanModal(id, name, currentPlan) {
      document.getElementById('planInstId').value = id;
      document.getElementById('planInstName').textContent = name || id;
      if (currentPlan) {
        document.getElementById('planTierSelect').value = currentPlan;
      }
      document.getElementById('planModal').classList.remove('hidden');
    }
    function closePlanModal() {
      document.getElementById('planModal').classList.add('hidden');
    }

    function openRevokeModal(id, name) {
      document.getElementById('revokeInstId').value = id;
      document.getElementById('revokeInstName').textContent = name || id;
      document.getElementById('revokeModal').classList.remove('hidden');
    }
    function closeRevokeModal() {
      document.getElementById('revokeModal').classList.add('hidden');
    }

    // Close modals on Escape key
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeGrantModal();
        closePlanModal();
        closeRevokeModal();
      }
    });
  </script>
</body>
</html>
